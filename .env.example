# Model providers. One key is enough to start; each extra key adds models to the pool.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Upstash Redis: rate limits, usage counters, shared provider cooldowns and the model catalogue snapshot.
# Vercel's KV_REST_API_URL and KV_REST_API_TOKEN are accepted instead. Empty values count as unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password for the /admin page.
ADMIN_PASSWORD=
# Signs admin cookies. Required in production, at least 32 characters. Generate: openssl rand -base64 48
ADMIN_SESSION_SECRET=
